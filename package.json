{
  "name": "foodapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply foodapp --local",
    "migrate:remote": "wrangler d1 migrations apply foodapp",
    "migrate:bubble": "node scripts/migrate-bubble.js"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.100.0"
  }
}
