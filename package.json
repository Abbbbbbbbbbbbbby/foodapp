{
  "name": "foodbox-data-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run pwa:build",
    "deploy": "npm run pwa:build && wrangler deploy",
    "test": "vitest run",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "test:watch": "vitest",
    "test:pwa": "vitest run --config vitest.pwa.config.ts",
    "migrate:local": "wrangler d1 migrations apply foodapp --local",
    "migrate:remote": "wrangler d1 migrations apply foodapp",
    "migrate:bubble": "node scripts/migrate-bubble.js",
    "pwa:dev": "vite --config src/pwa/vite.config.ts",
    "pwa:build": "vite build --config src/pwa/vite.config.ts && node scripts/inject-precache.mjs",
    "generate-types": "wrangler types",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "e2e:server": "npm run build && wrangler d1 migrations apply foodapp --local && wrangler dev --port 8787 --var ENVIRONMENT:test --var JWT_SECRET:e2e-local-secret --var TWILIO_ACCOUNT_SID:x --var TWILIO_AUTH_TOKEN:x --var TWILIO_PHONE_NUMBER:0000000000",
    "test:e2e": "playwright test",
    "test:pwa:coverage": "vitest run --config vitest.pwa.config.ts --coverage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.1",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "terser": "^5.49.0",
    "typescript": "^5.4.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  }
}
